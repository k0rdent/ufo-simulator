global:
  # JWT iss + Kong allowedIss. Must be https (or http loopback) — chart
  # k0rdent-apis.validateAuthIssuerUrl and services/auth validateIssuerBaseURL.
  # Keep k0rdent_apis_base_url as http for browser callback/CORS below.
  authIssuerUrl: "{{ k0rdent_apis_auth_issuer_url }}"
  imagePullSecret: "{{ k0rdent_apis_pull_secret_name }}"
  secrets:
    # The reconciler's NICo client credentials (Secret k0rdent-apis-nico),
    # replacing the kind placeholders. The same client the worker uses.
    nico:
      serviceAccountId: "{{ nico_client_id }}"
      serviceAccountPassword: "{{ k0rdent_apis_nico_sa_password }}"
{% if k0rdent_apis_gateway_tls_enabled | bool %}
  # The worker reads the issuer CA Secret from global.namespace.
  namespace: "{{ k0rdent_apis_namespace }}"
{% endif %}

auth:
  image:
    pullPolicy: Always
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-auth"
  env:
    # OAuth callback after IdP login — must be a URL the browser can reach
    AUTH_CALLBACK_URL: "{{ k0rdent_apis_base_url }}/v1/regions/global/auth/callback"
    # Drop the testing-site invite result page; set to your real URL if you serve one
    AUTH_INVITE_RESULT_URL: ""

# Chart default is ghcr.io/k0rdent/k0r-authz; socks can't pull anonymous ghcr.
authz:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-authz"
    pullPolicy: Always

iam:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-iam"
    pullPolicy: Always

organizations:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-organizations"
    pullPolicy: Always

compute:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-compute"
    pullPolicy: Always
  # Baseline security group rules for new NICo VPCs (KNF-551). A build that
  # predates KNF-551 ignores the key.
  securityGroupBaseline: {{ k0rdent_apis_security_group_baseline | to_json }}

infrastructure:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-infrastructure"
    pullPolicy: Always

notifications:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-notifications"
    pullPolicy: Always

reconciler:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-reconciler"
    pullPolicy: Always
  # Without these the NICo health worker idles and every server reports
  # healthStatus unknown. Credentials: global.secrets.nico.
  env:
    NICO_REST_API_BASE_URL: "{{ nico_api_base_url }}"
    NICO_ORG: "{{ nico_api_org }}"
    NICO_KEYCLOAK_BASE_URL: "{{ nico_keycloak_base_url }}"
    NICO_KEYCLOAK_REALM: "{{ nico_keycloak_realm }}"

# Enabled by the kind overlay. Chart default is ghcr.io/k0rdent/k0r-k8s-monitor;
# socks can't pull anonymous ghcr.
k8s-monitor:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-k8s-monitor"
    pullPolicy: Always

# Kind overlay sets IfNotPresent for a locally loaded image; we pull from MSR.
credentials:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-credentials"
    pullPolicy: Always

workflow:
  api:
    image:
      pullPolicy: Always
      repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-workflow"
    envSecretRef:
      WORKFLOW_DB_USER:     { secret: db, key: WORKFLOW_DB_USER }
      WORKFLOW_DB_PASSWORD: { secret: db, key: WORKFLOW_DB_PASSWORD }
    fileSecretRef: null
    env:
      # Restore the $(VAR) DSN that env-mode uses; the kind overlay nulled it.
      DATABASE_URL: "postgres://$(WORKFLOW_DB_USER):$(WORKFLOW_DB_PASSWORD)@postgres:5432/workflow?sslmode=disable"
      INTERNAL_SHARED_SECRET_FILE: null
      INTERNAL_SHARED_SECRET_PREV_FILE: null
      EXTERNAL_SHARED_SECRET_FILE: null
      EXTERNAL_SHARED_SECRET_PREV_FILE: null
      DATABASE_URL_FILE: null
  worker:
    image:
      pullPolicy: Always
      repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-workflow-worker"
    # Kind overlay puts the worker in SECRETS-ONLY file mode
    # (values-secret-kind.yaml). We need envSecretRef here for
    # NICO_SERVICE_ACCOUNT_PASSWORD (an out-of-band Secret, not one of the
    # db|app|serviceAuth buckets that fileSecretRef supports), so drop file
    # mode — same shape used for workflow.api above. Files XOR env, per
    # generic-service _deployment.tpl.
    fileSecretRef: null
    env:
      # Where invite emails point. Workflow-worker exits at boot if empty,
      # so set it even if you don't send invites yet.
      INVITE_BASE_URL: "{{ k0rdent_apis_base_url }}"
      NICO_REST_API_BASE_URL: "{{ nico_api_base_url }}"
      NICO_KEYCLOAK_BASE_URL: "{{ nico_keycloak_base_url }}"
      NICO_KEYCLOAK_REALM:   "{{ nico_keycloak_realm }}"
      NICO_SERVICE_ACCOUNT_ID: "{{ nico_client_id }}"
      DEFAULT_NICO_ORGANIZATION: "{{ nico_api_org }}"
      DEFAULT_NICO_SITE: "{{ nico_site_name }}"
      DEFAULT_NICO_SSH_KEY_GROUP_IDS: "{{ nico_ids.ssh_key_group_id }}"
      DEFAULT_NICO_TENANT_ID: "{{ nico_ids.tenant_id }}"
      DEFAULT_NICO_VPC_ID: "NOT-USED"
      DEFAULT_NICO_NETWORK_SECURITY_GROUP_ID: "{{ nico_ids.network_security_group_id }}"
      # The kind overlay sets a placeholder here; rendered after envSecretRef
      # below, it would win and NICo would refuse the client credentials.
      NICO_SERVICE_ACCOUNT_PASSWORD: null

    envSecretRef:
      NICO_SERVICE_ACCOUNT_PASSWORD:
        secretName: "{{ k0rdent_apis_nico_sa_secret }}"
        key: password
{% if k0rdent_apis_gateway_tls_enabled | bool %}
    # Lets workload clusters trust the TLS gateway's lab CA.
    clusterAuthentication:
      caSecretName: "{{ k0rdent_apis_issuer_ca_secret }}"
{% endif %}
  config:
    worker:
      mockMode: "false"
    reconciler:
      interval: "60s"
      retention: "24h"

keycloak:
  image:
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-keycloak"
    pullPolicy: Always
  # Twice the chart's limits (requests unchanged). At 500m CPU a cold start
  # (Quarkus build + realm import) took ~7m20s of the 630s startup-probe budget.
  resources:
    limits:
      cpu: "1"
      memory: 1536Mi

kong:
  image:
    pullPolicy: Always
    repository: "registry.ci.mirantis.com/k0rdent-apis/images/k0r-kong"
  cors:
    enabled: true
    # Browser's Origin header will be http://<UFO_IP>:30080 — Kong rejects
    # anything else for cross-origin requests.
    origins:
      - "{{ k0rdent_apis_base_url }}"
  k0rdentAuthz:
    # allowedIss is auto-derived from global.authIssuerUrl + /realms/<realm>,
    # so changing authIssuerUrl above is enough. Keep this from the kind values:
    additionalAllowedRealms:
      - "bootstrap"
