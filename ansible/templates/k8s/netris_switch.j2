---
apiVersion: k8s.netris.ai/v1alpha1
kind: Switch
metadata:
  name: {{ switch_name }}
  namespace: platform-admin
spec:
  tenant: Admin
  description: Spine switch
  nos: cumulus_nvue
  site: default
  # asn: 4200000021
  profile: {{ (ew_inventory_profile_name | default('roce-profile')) if switch_name.startswith('ew-') else (inventory_profile_name | default('default-inventory-profile')) }}
  mainIp: {{ loopback_ip }}
  mgmtIp: {{ mgmt_ip }}
  portsCount: 48
{# EW fabric (leaf + spine) uses 2-way breakout; set on Netris create only. #}
{% if switch_name.startswith('ew-') %}
  breakout: "{{ ew_switch_breakout | default('2x100') }}"
{% endif %}
### LINKS ####
{# VM/softgate links live in netris_server.j2 / netris_sg.j2 only. Emit switch-to-switch links here when this switch is the remote endpoint. #}
{% for link in links %}
{% if link.remote == switch_name %}
--- 
apiVersion: k8s.netris.ai/v1alpha1 
kind: Link 
metadata: 
  name: {{ switch_name }}-{{ link.remote_port | replace('/', '-') }}
  namespace: platform-admin
spec:
  ports: 
  - {{ link.local_port }}@{{ link.local }}
  - {{ link.remote_port }}@{{ link.remote }} 
{% endif %}
{% endfor %}
### END LINKS ###
