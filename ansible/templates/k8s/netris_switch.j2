---
apiVersion: k8s.netris.ai/v1alpha1
kind: Switch
metadata:
  name: {{ switch_name }}
  namespace: platform-admin
spec:
  tenant: Admin
  description: {{ switch_role | capitalize }} switch
  nos: cumulus_nvue
  swRole: {{ switch_role }}
  site: default
  # asn: 4200000021
{# EW membership comes from ew_switch_names: the EW names carry Verity's fabric
   coordinates (ewf-leaf-su00-r0), so there is no shared prefix to test for. #}
  profile: {{ (ew_inventory_profile_name | default('roce-profile')) if switch_name in ew_switch_names else (inventory_profile_name | default('default-inventory-profile')) }}
  mainIp: {{ loopback_ip }}
  mgmtIp: {{ mgmt_ip }}
{# EW models a 64-port Spectrum-X, so its fabric links reach swp57+; declaring
   48 here would leave those ports undefined on the Netris side. #}
  portsCount: {{ (ew_switch_ports_count | default(64)) if switch_name in ew_switch_names else (switch_ports_count | default(48)) }}
{# EW fabric (leaf + spine) uses 2-way breakout; set on Netris create only. #}
{% if switch_name in ew_switch_names %}
  breakout: "{{ ew_switch_breakout | default('2x100') }}"
{% endif %}
### LINKS ####
{# VM/softgate links live in netris_server.j2 / netris_sg.j2 only. Emit switch-to-switch links here when this switch is the remote endpoint. #}
{% for link in links %}
{% if link.remote == switch_name %}
--- 
apiVersion: k8s.netris.ai/v1alpha1 
kind: Link 
metadata: 
  name: {{ switch_name }}-{{ link.remote_port | replace('/', '-') }}
  namespace: platform-admin
spec:
  ports: 
  - {{ link.local_port }}@{{ link.local }}
  - {{ link.remote_port }}@{{ link.remote }} 
{% endif %}
{% endfor %}
### END LINKS ###
