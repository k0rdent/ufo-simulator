{%- set server_ports = [] %}
{%- set rail_ports = {} %}
{%- set is_spectrum = switch.type is defined and switch.type == 'spectrum-x' %}
{%- for link in links %}
{%-   if link.local == switch_name and link.remote.startswith('vm-') %}
{%-     set _ = server_ports.append(link.local_port) %}
{%-     if is_spectrum and link.rail_id is defined %}
{%-       if link.rail_id not in rail_ports %}
{%-         set _ = rail_ports.update({link.rail_id: []}) %}
{%-       endif %}
{%-       set _ = rail_ports[link.rail_id].append(link.local_port) %}
{%-     endif %}
{%-   endif %}
{%- endfor %}
{% if server_ports %}
---
apiVersion: ufo.mirantis.com/v1alpha1
kind: Switch
metadata:
  name: {{ switch_name }}
  namespace: platform-admin
spec:
  hostname: {{ switch_name }}
  server_ports: {{ server_ports | join(',') }}
{# Rail leaves carry no PXE. provisioning_network routes a switch into UFO's
   Clos provisioning path, which parks every free server port on the network
   with a Verity Switchport named <port>@<hostname> -- and then looks up
   "Bundle for <hostname>", which a Spectrum-X leaf does not have (Verity names
   those by fabric coordinates, e.g. ewf-leaf-su00-r7). PXE belongs to the
   north-south leaf-0; see ctl.j2. #}
{% if not is_spectrum %}
  provisioning_network:
    name: pxe
{% endif %}
{% if switch.type is defined %}
  type: {{ switch.type }}
{% endif %}
{% if is_spectrum %}
{% if switch.plane_id is defined %}
  plane_id: {{ switch.plane_id }}
{% endif %}
{% if switch.pod_id is defined %}
  pod_id: {{ switch.pod_id }}
{% endif %}
{% if switch.su_id is defined %}
  su_id: {{ switch.su_id }}
{% endif %}
{% if switch.rail_id is defined %}
  rail_id: {{ switch.rail_id }}
{% endif %}
{% if rail_ports %}
  rail_groups:
{% for rail_id, ports in rail_ports.items() %}
    - ports: "{{ ports | join(',') }}"
      rail_id: {{ rail_id }}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
